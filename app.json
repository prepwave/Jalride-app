{
  "expo": {
    "name": "jalride-app",
    "slug": "jalride-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalride.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow JalRide to access your camera to scan ghat standee posters and digital boarding tickets.",
        "NSLocationWhenInUseUsageDescription": "Allow JalRide to access your location to discover nearby Varanasi boarding ghats."
      }
    },
    "android": {
      "package": "com.jalride.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JalRide to access your camera to scan ghat standee posters and boarding tickets."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
