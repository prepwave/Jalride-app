{
  "expo": {
    "name": "jalride-app",
    "slug": "jalride-app",
    "scheme": "jalride-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalride.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow JalRide to access your camera to scan ghat standee posters and digital boarding tickets.",
        "NSLocationWhenInUseUsageDescription": "Allow JalRide to access your location to discover nearby Varanasi boarding ghats."
      }
    },
    "android": {
      "package": "com.jalride.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a2e36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JalRide to access your camera to scan ghat standee posters and boarding tickets."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a2e36",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a2e36"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "949018a4-f999-4e81-a8f4-6a2407072220"
      }
    }
  }
}
